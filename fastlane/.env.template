# Copy this to ios/fastlane/.env (which is gitignored) and fill in.
#
# 1) Generate an App Store Connect API key:
#    https://appstoreconnect.apple.com/access/integrations/api
#    - Click + to create a new key
#    - Role: App Manager (or Admin if you also need access management)
#    - Download the .p8 file IMMEDIATELY (you only get one chance)
#    - Note the Key ID (10 chars) and Issuer ID (uuid)
#
# 2) Move the .p8 file somewhere safe (NOT in this repo). Reference its absolute path.

# Apple identifiers
FASTLANE_APPLE_ID=you@example.com           # the Apple ID on your developer account
FASTLANE_TEAM_ID=ABCDE12345                 # 10-char Developer Team ID (developer.apple.com → Membership)
FASTLANE_ITC_TEAM_ID=                       # ASC team id, often blank or numeric — fastlane prompts on first run

# App Store Connect API key (preferred over Apple ID/password — works with 2FA, no prompts)
ASC_API_KEY_FILEPATH=/Users/you/.appstoreconnect/keys/AuthKey_ABCDE12345.p8
ASC_API_KEY_ID=ABCDE12345                   # 10-char Key ID shown in ASC
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000  # Issuer ID (UUID)

# Optional — release-time changelog for TestFlight uploads
TESTFLIGHT_CHANGELOG="Internal build."
